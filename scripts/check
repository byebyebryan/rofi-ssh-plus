#!/usr/bin/env bash
set -euo pipefail

repo_root=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

python3 -m compileall -q rofi_ssh_plus bin tests
python3 -m unittest discover -s tests -p 'test_*.py' -q

mapfile -d '' -t candidate_files < <(git ls-files --cached --others --exclude-standard -z)
python3 - "${candidate_files[@]}" <<'PY'
from pathlib import Path
import sys

for name in sys.argv[1:]:
    path = Path(name)
    if not path.is_file():
        continue
    data = path.read_bytes()
    if data and not data.endswith(b"\n"):
        raise SystemExit(f"{name}: missing final newline")
    for line_number, line in enumerate(data.splitlines(), 1):
        if line.endswith((b" ", b"\t")):
            raise SystemExit(f"{name}:{line_number}: trailing whitespace")
PY

python3 - <<'PY'
import json
from pathlib import Path

fixture_root = Path("contracts/host-mesh-v1/fixtures")
required = (
    "config-local-only.toml",
    "config-multi-route.toml",
    "config-invalid-duplicate.toml",
    "config-invalid-ambiguous.toml",
    "route-reports.json",
    "route-order.json",
    "reached-markers.json",
    "history-migration.json",
    "envelopes.json",
)
for name in required:
    path = fixture_root / name
    if not path.is_file():
        raise SystemExit(f"missing conformance fixture: {path}")
    if path.suffix == ".json":
        json.loads(path.read_text(encoding="utf-8"))
envelopes = json.loads((fixture_root / "envelopes.json").read_text(encoding="utf-8"))
expected_errors = {
    "invalid_input",
    "invalid_config",
    "unsupported_schema",
    "unknown_host",
    "unknown_route",
    "stale_mesh",
    "persistence_failed",
}
if set(envelopes.get("errors", {})) != expected_errors:
    raise SystemExit("error-envelope fixture does not cover every stable code")
PY

test -x bin/rofi-ssh-plus
test -x scripts/check
test -f README.md
test -f docs/DESIGN.md
test -f rofi_ssh_plus/__init__.py
test -f tests/test_entrypoint.py

git diff --check
git diff --cached --check

printf '%s\n' '[ok] Python syntax, unit tests, executable bits, expected files, and diff checks'
