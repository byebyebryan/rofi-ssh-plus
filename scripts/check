#!/usr/bin/env bash
set -euo pipefail

repo_root=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

python3 -m compileall -q rofi_ssh_plus bin tests
python3 -m unittest discover -s tests -p 'test_*.py' -q

mapfile -d '' -t candidate_files < <(git ls-files --cached --others --exclude-standard -z)
python3 - "${candidate_files[@]}" <<'PY'
from pathlib import Path
import sys

for name in sys.argv[1:]:
    path = Path(name)
    if not path.is_file():
        continue
    data = path.read_bytes()
    # Raw byte fixtures intentionally exercise a missing final LF.  Every
    # source/document file remains LF-terminated.
    if path.suffix != ".bin" and data and not data.endswith(b"\n"):
        raise SystemExit(f"{name}: missing final newline")
    if path.suffix != ".bin":
        for line_number, line in enumerate(data.splitlines(), 1):
            if line.endswith((b" ", b"\t")):
                raise SystemExit(f"{name}:{line_number}: trailing whitespace")
PY

python3 - <<'PY'
import json
from pathlib import Path

fixture_root = Path("contracts/host-mesh-v1/fixtures")
required = (
    "config-local-only.toml",
    "config-multi-route.toml",
    "config-invalid-duplicate.toml",
    "config-invalid-ambiguous.toml",
    "route-reports.json",
    "route-order.json",
    "reached-markers.json",
    "envelopes.json",
)
for name in required:
    path = fixture_root / name
    if not path.is_file():
        raise SystemExit(f"missing conformance fixture: {path}")
    if path.suffix == ".json":
        json.loads(path.read_text(encoding="utf-8"))
envelopes = json.loads((fixture_root / "envelopes.json").read_text(encoding="utf-8"))
expected_errors = {
    "invalid_input",
    "invalid_config",
    "unsupported_schema",
    "unknown_host",
    "unknown_route",
    "stale_mesh",
    "persistence_failed",
}
if set(envelopes.get("errors", {})) != expected_errors:
    raise SystemExit("error-envelope fixture does not cover every stable code")
PY

python3 - <<'PY'
import hashlib
import re
from pathlib import Path

bundle = Path("contracts/host-mesh-v1")
checksum_path = bundle / "SHA256SUMS"
if not checksum_path.is_file():
    raise SystemExit(f"missing contract checksum manifest: {checksum_path}")
raw = checksum_path.read_bytes()
if not raw.endswith(b"\n"):
    raise SystemExit("SHA256SUMS: missing final newline")
pattern = re.compile(rb"^([0-9a-f]{64})  ([^\x00\r\n]+)\n$")
entries: list[tuple[str, str]] = []
for line in raw.splitlines(keepends=True):
    match = pattern.fullmatch(line)
    if match is None:
        raise SystemExit("SHA256SUMS: malformed entry")
    digest, relative = match.groups()
    name = relative.decode("utf-8")
    path = Path(name)
    if path.is_absolute() or ".." in path.parts or name == "SHA256SUMS":
        raise SystemExit(f"SHA256SUMS: invalid path {name!r}")
    entries.append((name, digest.decode("ascii")))
names = [name for name, _digest in entries]
if names != sorted(names, key=lambda name: name.encode("utf-8")) or len(
    names
) != len(set(names)):
    raise SystemExit("SHA256SUMS: entries must be unique and bytewise sorted")
actual = sorted(
    (
        str(path.relative_to(bundle)).replace("\\", "/")
        for path in bundle.rglob("*")
        if path.is_file() and path != checksum_path
    ),
    key=lambda name: name.encode("utf-8"),
)
if names != actual:
    raise SystemExit("SHA256SUMS: file set does not match the complete bundle")
for name, expected in entries:
    actual_digest = hashlib.sha256((bundle / name).read_bytes()).hexdigest()
    if actual_digest != expected:
        raise SystemExit(f"SHA256SUMS: digest mismatch for {name}")
print(f"[ok] Host Mesh bundle digest {hashlib.sha256(raw).hexdigest()}")
PY

test -x bin/rofi-ssh-plus
test -x scripts/check
test -f README.md
test -f docs/DESIGN.md
test -f rofi_ssh_plus/__init__.py
test -f tests/test_entrypoint.py

git diff --check
git diff --cached --check

printf '%s\n' '[ok] Python syntax, unit tests, executable bits, expected files, and diff checks'
